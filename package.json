{
  "name": "dvpotro",
  "version": "0.2.1",
  "private": true,
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "start": "concurrently \"npm run dev\" \"npm run electron\"",
    "preview": "vite preview",
    "report": "node generate-report.js",
    "test:analyzer": "node scripts/test-activity-analyzer.cjs",
    "llm:doctor": "node scripts/llm-doctor.cjs",
    "start:demo": "node scripts/start-demo.cjs",
    "dist": "vite build && electron-builder --config electron-builder.config.js",
    "dist:dir": "vite build && electron-builder --config electron-builder.config.js --dir",
    "test:horario": "node scripts/test-horario-modalidad.cjs",
    "test:modalidad": "node scripts/test-modalidad-deteccion.cjs",
    "test:cache": "node scripts/test-horario-cache-version.cjs",
    "test:upload": "node scripts/test-upload-validacion.cjs",
    "test:accepted-types": "node scripts/test-accepted-types.cjs",
    "test:material": "node scripts/test-material-clasificacion.cjs",
    "spike:material": "node scripts/spike-material-recon.cjs",
    "test:force-resync": "node scripts/test-force-resync.cjs",
    "test:attendance": "node scripts/test-attendance.cjs",
    "spike:attendance": "node scripts/spike-attendance-recon.cjs",
    "test:prompt": "node scripts/test-prompt-builder.cjs",
    "test:drive": "node scripts/test-drive-normalizacion.cjs",
    "test:clasificacion": "node scripts/test-clasificacion.cjs",
    "test:fechas": "node scripts/test-fechas.cjs",
    "mcp": "node mcp/dvpotro-mcp.js",
    "test:notes-images": "electron scripts/test-notes-image-actions.cjs",
    "test:extraccion": "node scripts/test-extraccion-contenido.cjs",
    "test:scrape": "node scripts/test-scrape-timing.cjs",
    "test:drive:red": "electron scripts/test-drive-red.cjs",
    "drive:resolve": "electron scripts/resolve-drive-once.cjs",
    "test:mcp-drive": "node scripts/test-mcp-drive.cjs",
    "test:drive:llm": "node scripts/test-drive-llm.cjs"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "music-metadata": "^11.14.0",
    "pdf-parse": "^1.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "playwright": "^1.60.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.2"
  },
  "build": {
    "appId": "mx.itson.dvpotro",
    "productName": "DVPotro",
    "copyright": "DVPotro — ITSON academic tracker",
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DVPotro",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json",
      "index.html",
      "build/icon.*"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "orsted118",
      "repo": "scraper-app"
    }
  },
  "description": "DVPotro desktop academic tracker for ITSON portals."
}
